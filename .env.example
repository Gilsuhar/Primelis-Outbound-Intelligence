# PostgreSQL-compatible connection string.
# Use a local PostgreSQL database or Supabase project connection string.
# Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Optional direct connection for Supabase migration workflows.
# Often the same as DATABASE_URL for local PostgreSQL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase Auth public browser/server SSR configuration.
# These values are public by design, but still use real values only in local or deployment envs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy fallback; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Canonical app URL used for private preview magic-link redirects.
NEXT_PUBLIC_APP_URL=""

# Optional server-side AI provider for draft generation/refinement.
# Leave blank to use the deterministic development fallback.
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Optional. Enables "Fetch profile" on Build Sequence, which looks up a pasted
# LinkedIn profile URL via GetLeads' enrichment API, not LinkedIn scraping.
# Leave blank to disable; users can still paste profile context manually.
GETLEADS_API_KEY=""

# Optional. Enables sending generated Build Sequence drafts to HubSpot as a
# company note plus review task.
HUBSPOT_PRIVATE_APP_TOKEN=""
# Optional: set USD only after confirming the HubSpot company revenue field currency.
HUBSPOT_COMPANY_REVENUE_CURRENCY=""

# Gate A reuses OPENAI_API_KEY and OPENAI_MODEL above. No deterministic fallback.
# Optional separate model with Responses web_search support; otherwise OPENAI_MODEL is used.
OPENAI_RESEARCH_MODEL=""
# Optional token-only estimates for OPENAI_MODEL. Leave blank when rates are unknown.
# Estimates exclude web-search tool fees and unreported retries.
OPENAI_INPUT_USD_PER_MILLION=""
OPENAI_OUTPUT_USD_PER_MILLION=""

# Read-only integrations (server only; configure Preview, never NEXT_PUBLIC_)
# Gil's existing application User.id; binds the shared bootstrap grant to one operator
INTEGRATION_OPERATOR_USER_ID=
HUBSPOT_PORTAL_ID=
# Explicit UTC admission cutoff, e.g. first day of the team's review rollout
HUBSPOT_SYNC_START_AT=
# Optional existing HubSpot property containing an explicit Outreach prospect ID
HUBSPOT_OUTREACH_ID_PROPERTY=
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REDIRECT_URI=
# Bootstrap OAuth grant for the single authorized sync operator; rotated tokens are encrypted in DB
OUTREACH_REFRESH_TOKEN=
# Base64-encoded 32-byte random AES-256 key; retain securely for decrypting rotated grants
INTEGRATION_ENCRYPTION_KEY=
# At least 32 random characters; optional external scheduler bearer credential
INTEGRATION_WORKER_SECRET=

# Optional independent verification; server only. No provider is assumed configured.
# ZEROBOUNCE uses separately purchased credits; GATEWAY uses your authorized provider service.
EMAIL_VERIFICATION_PROVIDER=
ZEROBOUNCE_API_KEY=
# Authorized HTTPS gateway base URL; POST /email and /employment use the strict v1 evidence contract.
VERIFICATION_GATEWAY_URL=
VERIFICATION_GATEWAY_TOKEN=
VERIFICATION_GATEWAY_PROVIDER_ID=
